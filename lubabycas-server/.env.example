# ══════════════════════════════════════════
#  LuBabycas — Variables de entorno
#  Copia este archivo como .env y completa
# ══════════════════════════════════════════

PORT=3000

# ── NGROK (para cámara en celular) ───────
# Obtén tu token gratis en: https://ngrok.com
# Dashboard → Your Authtoken
NGROK_TOKEN=tu_token_aqui

# ── SHOPIFY ───────────────────────────────
# Shopify Admin → Configuración → Apps → Desarrollar apps
SHOPIFY_DOMAIN=tutienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01

# ── SEGURIDAD ─────────────────────────────
SESSION_SECRET=lubabycas_secret_cambiar_esto
